{
  "name": "tastapi",
  "version": "0.1.0",
  "description": "A typed, FastAPI-style web framework for TypeScript, built on zod and the fetch API.",
  "keywords": [
    "bun",
    "cloudflare-workers",
    "deno",
    "fastapi",
    "fetch",
    "openapi",
    "router",
    "zod"
  ],
  "homepage": "https://github.com/Kludex/tastapi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kludex/tastapi.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:bun": "bun --bun node_modules/vitest/vitest.mjs run",
    "test:deno": "deno run -A node_modules/vitest/vitest.mjs run",
    "bench": "node bench/node.ts && node bench/workers.ts",
    "docs": "uvx --from 'mkdocs<2' --with mkdocs-material mkdocs build --strict",
    "docs:serve": "uvx --from 'mkdocs<2' --with mkdocs-material mkdocs serve"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autocannon": "^8.0.0",
    "hono": "^4.13.13",
    "itty-router": "^5.0.24",
    "miniflare": "^4.20260730.0",
    "mitata": "^1.0.34",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rolldown": "^1.2.14",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "engines": {
    "node": ">=20"
  }
}
